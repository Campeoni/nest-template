# ─── Server ──────────────────────────────────────────────
PORT=3000

# ─── Logging ─────────────────────────────────────────────
# Nivel mínimo de log: verbose | debug | log | warn | error | fatal.
# Elegir uno habilita ese nivel y los superiores (warn emite warn, error y
# fatal). Un valor ausente o inválido cae a "log": un error de tipeo no debe
# silenciar los logs. La línea de arranque (banner) se emite siempre, sin
# importar este nivel.
# LOG_LEVEL=log

# Carpeta donde se escribe el archivo de log. Admite ruta absoluta o relativa
# (la relativa se resuelve contra el directorio de trabajo del proceso). Si no
# se define, se usa el directorio de trabajo.
# LOG_DIR=

# Fuerza la escritura a archivo en desarrollo (true|false). Sin esta variable,
# en desarrollo el log va únicamente a consola. Solo acepta "true" o "false".
# LOG_TO_FILE=false

# Nombre del archivo de log dentro de LOG_DIR. Default: app.log.
# LOG_FILE=app.log

# ─── Swagger ─────────────────────────────────────────────
# Monta la documentación en /api/docs (true|false). Apagado por defecto: solo
# se habilita con el valor exacto "true". Solo acepta "true" o "false".
# SWAGGER_ENABLED=false

# ─── Variables de tu aplicación ─────────────────────────
# Agregá acá TODAS las variables de entorno que necesites.
#
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb
# JWT_SECRET=
# GEMINI_API_KEY=
